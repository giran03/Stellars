  "narrative": {
    "overview": "This document describes only the isolated `?mock` prototype in `src/mock`. The live console retains the root design system until a separate integration decision.\n\nThe approved direction pairs rounded charcoal surfaces with violet and teal, dense audio controls, dot-matrix activity and restrained animation. The user-supplied black healthcare dashboard informed the visual composition; the shipped screen expresses Stellars' five audio buses and independent Stream mix. This is an interactive design preview with simulated data.",
    "keyCharacteristics": [
      "Rounded, tonally separated surfaces with subtle light at their upper edges.",
      "Quiet typography, tabular audio readouts and compact labels.",
      "Persistent channel colors connecting routing, selection and EQ.",
      "Small entrance and hover movements, with reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Channel Identity Rule",
        "body": "Keep a bus color consistent across its meter, route label and EQ preview.",
        "section": "colors"
      },
      {
        "name": "The Precise Entry Rule",
        "body": "Numeric readouts and edited values use at most two decimal places; percentages round to whole numbers. Field bounds remain authoritative, and slider step does not quantize typed entries.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve channel identity across routing, meters and EQ.",
      "Do use shared keyboard controls and visible focus alongside drag routing.",
      "Do retain responsive wrapping, reduced-motion behavior and explicit meter pause.",
      "Do label illustrative activity and device names as demo data."
    ],
    "donts": [
      "Don't present the preview curve or meter values as measured audio.",
      "Don't apply this prototype's tokens to the live console without a separate integration decision.",
      "Don't embed the inspiration screenshot or review screenshots in the product UI."
    ]
  }
