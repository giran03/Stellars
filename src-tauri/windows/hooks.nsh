; Stellars NSIS Installer Hook — Automated WHQL VB-CABLE + Hi-Fi Cable Setup & System-Wide Endpoint Naming
!macro NSIS_HOOK_POSTINSTALL
  DetailPrint "Checking WHQL Virtual Audio Cable endpoints for Stellars (Silent Sink, Mic & Stream)..."
  nsExec::ExecToLog 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -Command "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $$staging = Join-Path $$env:LOCALAPPDATA \"StellarsSonar\drivers\"; New-Item -ItemType Directory -Force -Path $$staging | Out-Null; $$vbPresent = Get-PnpDevice -PresentOnly -ErrorAction SilentlyContinue | Where-Object { $$_.FriendlyName -match \"VB-Audio Virtual Cable|CABLE Input|Stellars Virtual Audio Cable\" -or $$_.InstanceId -match \"VBAudioVACWDM\" }; if (-not $$vbPresent) { $$vbZip = Join-Path $$staging \"VBCABLE_Driver_Pack.zip\"; $$vbDir = Join-Path $$staging \"vbcable\"; New-Item -ItemType Directory -Force -Path $$vbDir | Out-Null; try { Invoke-WebRequest -Uri \"https://download.vb-audio.com/Download_CABLE/VBCABLE_Driver_Pack46.zip\" -OutFile $$vbZip -UseBasicParsing -TimeoutSec 30; Expand-Archive -Path $$vbZip -DestinationPath $$vbDir -Force; pnputil.exe /add-driver (Join-Path $$vbDir \"vbMmeCable64_win10.inf\") /install | Out-Null; Start-Process -FilePath (Join-Path $$vbDir \"VBCABLE_Setup_x64.exe\") -ArgumentList \"-i\",\"-h\" -WorkingDirectory $$vbDir -Wait -WindowStyle Hidden } catch {} }; $$hifiPresent = Get-PnpDevice -PresentOnly -ErrorAction SilentlyContinue | Where-Object { $$_.FriendlyName -match \"Hi-Fi Cable|Stellars Hi-Fi\" -or $$_.InstanceId -match \"VBAudioHFVAIO\" }; if (-not $$hifiPresent) { $$hifiZip = Join-Path $$staging \"HiFiCableAsioBridgeSetup.zip\"; $$hifiDir = Join-Path $$staging \"hificable\"; New-Item -ItemType Directory -Force -Path $$hifiDir | Out-Null; try { Invoke-WebRequest -Uri \"https://download.vb-audio.com/Download_CABLE/HiFiCableAsioBridgeSetup_v1007.zip\" -OutFile $$hifiZip -UseBasicParsing -TimeoutSec 30; Expand-Archive -Path $$hifiZip -DestinationPath $$hifiDir -Force; Start-Process -FilePath (Join-Path $$hifiDir \"HiFiCableAsioBridgeSetup.exe\") -ArgumentList \"-i\",\"-h\" -WorkingDirectory $$hifiDir -Wait -WindowStyle Hidden } catch {} }; pnputil.exe /scan-devices | Out-Null; $$script = Join-Path $$PSScriptRoot \"install-vbcable.ps1\"; if (Test-Path $$script) { & $$script }"'
!macroend
